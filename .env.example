# Copy to .env.local and fill in. Never commit .env.local or real keys.
# See docs/SETUP.md for where to find each value.

# Supabase project (region: North EU / Stockholm)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_…) – safe in the browser, RLS protects data
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) – SERVER ONLY. Bypasses RLS. Never expose.
SUPABASE_SECRET_KEY=

# Public URL of the app, used in invitation and password-reset links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI ---------------------------------------------------------------------
# "mock" (default): no external AI calls at all.
# "openai": OpenAI answers according to FOLKE_AI_EXTERNAL_DATA.
FOLKE_AI_PROVIDER=mock
# "synthetic-only" (default): only synthetic test conversations use OpenAI.
# "approved-documents": ordinary conversations use OpenAI too, with documents
# a system administrator approved one by one in the knowledge base (ADR-036).
# Unapproved documents are never sent. folke-dev uses approved-documents.
FOLKE_AI_EXTERNAL_DATA=synthetic-only

# OpenAI – SERVER ONLY. Never commit or log the key.
OPENAI_API_KEY=
# Optional: project/organization ids (otherwise the key's defaults are used).
OPENAI_PROJECT=
OPENAI_ORGANIZATION=
# Optional: https://api.openai.com/v1 (default) or https://eu.api.openai.com/v1.
# Use the EU endpoint ONLY if the OpenAI project is approved for EU data residency.
OPENAI_BASE_URL=

# Models (must exist in the catalog in src/server/ai/models.ts).
# Choosable chat models (comma-separated subset; empty = whole catalog):
FOLKE_CHAT_MODELS=gpt-6-luna,gpt-6.1-sol
# Default for assistants without an explicit choice:
FOLKE_CHAT_MODEL_DEFAULT=gpt-6-luna
FOLKE_EMBEDDING_MODEL=text-embedding-3-small

# Server-side limits and budget stops (estimates; OpenAI's project budget is a
# second line of defence, not a guaranteed hard limit).
FOLKE_AI_USER_DAILY_LIMIT_USD=0.5
FOLKE_AI_MONTHLY_LIMIT_USD=10
FOLKE_AI_MAX_CONCURRENT_PER_USER=2
FOLKE_AI_MAX_REQUESTS_PER_MINUTE=10
FOLKE_AI_MAX_OUTPUT_TOKENS=1200
FOLKE_AI_TIMEOUT_MS=45000
# For the SEK column in usage reports (estimate):
FOLKE_USD_TO_SEK=10.5
