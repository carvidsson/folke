{
  "name": "folke",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test",
    "test": "vitest run",
    "test:db": "vitest run tests/db",
    "bootstrap:admin": "node --env-file=.env.local scripts/bootstrap-admin.mjs",
    "seed:synthetic": "node --env-file=.env.local scripts/seed-synthetic.mjs",
    "db:push": "npx supabase db push",
    "test:live": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.live.config.mts",
    "test:ai-eval": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.eval.config.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.109.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.49.0",
    "mammoth": "^1.13.0",
    "next": "16.3.8",
    "openai": "^7.25.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
